def calculate(text):
text = text.replace(" ", "")
pos = 0
def number():
nonlocal pos
start = pos
while pos < len(text) and (text[pos].isdigit() or text[pos] == "."):
pos += 1
return float(text[start:pos])
def primary():
nonlocal pos
if text[pos] == "-":
pos += 1
return -primary()
if text[pos] == "+":
pos += 1
return primary()
if text[pos] == "(":
pos += 1
value = expr()
pos += 1 # пропускаем ")"
return value
return number()
def term():
nonlocal pos
value = primary()
while pos < len(text) and text[pos] in "*/":
op = text[pos]
pos += 1
right = primary()
if op == "*":
value = value * right
else:
value = value / right
return value
def expr():
nonlocal pos
value = term()
while pos < len(text) and text[pos] in "+-":
op = text[pos]
pos += 1
right = term()
if op == "+":
value = value + right
else:
value = value - right
return value
return expr()
s = input("Введите выражение: ")
print(calculate(s))